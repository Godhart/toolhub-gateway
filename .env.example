DOMAIN=tools.example.com
EMAIL=admin@example.com
TOOLHUB_UPSTREAM=toolhub-router:3000
# Existing router container, or empty if already connected to the network.
TOOLHUB_CONTAINER=YOUR_TOOLHUB_CONTAINER
TOOLHUB_NETWORK=toolhub-edge
NGINX_IMAGE=nginx:stable-alpine
CERTBOT_IMAGE=certbot/certbot:latest
# Actual public MCP endpoint path. May be /sse for legacy transport.
MCP_PATH=/mcp
TOOLHUB_USERNAME=toolhub-user
# Copy the exact callback shown in ChatGPT; no wildcard.
OAUTH_REDIRECT_URI=https://chatgpt.com/connector_platform_oauth_redirect
